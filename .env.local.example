NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: when set, the triage service calls N8N for AI classification.
# Leave blank to use the local rule-based stub (good for offline demo).
N8N_TRIAGE_WEBHOOK_URL=

# Shared secret for the /api/webhooks/whatsapp endpoint. Postman sends this
# in the X-Demo-Secret header. Production should switch to HMAC.
WHATSAPP_WEBHOOK_SECRET=